{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "pixforge_preview_demo:block/frame",
        "y": 0,
        "uvlock": true
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "pixforge_preview_demo:block/glass",
        "y": 0,
        "uvlock": true
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "pixforge_preview_demo:block/leaves",
        "y": 0,
        "uvlock": true
      }
    },
    {
      "when": {
        "AND": [
          {
            "facing": "north"
          },
          {
            "active": "true"
          }
        ]
      },
      "apply": {
        "model": "pixforge_preview_demo:block/glow",
        "y": 0,
        "uvlock": true
      }
    },
