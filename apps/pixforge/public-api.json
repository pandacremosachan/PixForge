{
  "schema": "pixforge.application/v4",
  "application": "PixForge",
  "version": "4.12.1",
  "public_api_version": 4,
  "interfaces": [
    "resident-http",
    "command-line"
  ],
  "resident": {
    "start": "PixForgeNative.exe serve --workspace DIR --runtime DIR",
    "discovery": "RUNTIME/commands.json",
    "schema": "pixforge.commands/v1",
    "commands": "POST /v1/commands",
    "help": "GET /v1/commands[/GROUP[/COMMAND]]",
    "auth_header": "X-PixForge-Session"
  },
  "commands": {
    "help": "--help",
    "version": "--version",
    "groups": [
      "project",
      "canvas",
      "model",
      "animation",
      "minecraft",
      "workbench",
      "asset"
    ]
  },
  "compatibility": "One executable for the desktop and grouped commands. Command parameters are validated; help is on demand. Existing project/history formats remain compatible.",
  "capabilities": [
    "minecraft-player-skin/v1",
    "minecraft-player-skin-atlas/v1",
    "minecraft-assets/v1",
    "forge-runtime/v1",
    "minecraft-preview/v1",
    "minecraft-animation/v1",
    "minecraft-regression/v1",
    "minecraft-material/v1",
    "blockbench-player-rig/v1",
    "blockbench-player-rig/v2",
    "rig-component-edit/v1",
    "canvas-resize/v1"
  ]
}
